# Generation provider. Use `none` for the extractive cited fallback, `ollama` for a local
# model, or `openai` for the hosted OpenAI-compatible endpoint.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Retrieval defaults
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIRECTORY=.rag-index
CORPUS_DATASET=freshstack/corpus-oct-2024
CORPUS_SUBSET=langchain
CORPUS_SPLIT=train
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8

# Evidence and generation limits. The term-overlap gate is a conservative temporary guard;
# calibrate it against development evaluation results before a final evaluation. Especially needed since it's a local PoC
MIN_EVIDENCE_TERM_OVERLAP=2
MAX_CONTEXT_CHARACTERS=12000
MAX_CHUNK_CHARACTERS=4000
GENERATION_MAX_TOKENS=512

# Retrieval evaluation defaults. Evaluation data is never supplied to the assistant.
QUERY_DATASET=freshstack/queries-oct-2024
QUERY_SUBSET=langchain
QUERY_SPLIT=test
EVALUATION_DIRECTORY=results
EVALUATION_SEED=42
DEVELOPMENT_FRACTION=0.7

# Generated-answer evaluation defaults. Use a fixed development subset while tuning;
# set ANSWER_EVALUATION_LIMIT=0 only when evaluating the full selected partition.
ANSWER_EVALUATION_LIMIT=25
NUGGET_COVERAGE_THRESHOLD=0.5