# OpenAI-compatible provider configuration. Use `none` for the extractive cited fallback,
# or set `openai`, a model name, and an API key to enable answer synthesis.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Retrieval defaults
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIRECTORY=.rag-index
CORPUS_DATASET=freshstack/corpus-oct-2024
CORPUS_SUBSET=langchain
CORPUS_SPLIT=train
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8