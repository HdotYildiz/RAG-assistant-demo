# Generation provider. Use `none` for the extractive cited fallback, `ollama` for a local
# model, or `openai` for the hosted OpenAI-compatible endpoint.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Retrieval defaults
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIRECTORY=.rag-index
CORPUS_DATASET=freshstack/corpus-oct-2024
CORPUS_SUBSET=langchain
CORPUS_SPLIT=train
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8

# Retrieval evaluation defaults. Evaluation data is never supplied to the assistant.
QUERY_DATASET=freshstack/queries-oct-2024
QUERY_SUBSET=langchain
QUERY_SPLIT=test
EVALUATION_DIRECTORY=results
EVALUATION_SEED=42
DEVELOPMENT_FRACTION=0.7