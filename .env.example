# Optional OpenAI-compatible provider configuration. Leave LLM_PROVIDER as none to use
# the extractive, cited fallback that does not need credentials.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Retrieval defaults
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIRECTORY=.rag-index
CORPUS_DATASET=freshstack/corpus-oct-2024
CORPUS_SUBSET=langchain
CORPUS_SPLIT=train
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=8